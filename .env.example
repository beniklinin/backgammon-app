# Copy this file to .env.local and fill in your own Supabase project credentials.
# Without these, the app still works fully for local play (AI + pass-and-play);
# accounts, chat, leaderboard, and online rooms will show a "connect Supabase" notice.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
